{
  "name": "pr-review-ci",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "On-demand multi-model PR reviewer. Diverse non-Claude panel via OpenRouter, one combined review.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "review": "node --import tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
